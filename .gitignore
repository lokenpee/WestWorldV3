# 个人小说原文；保留自动化测试使用的小样本
/tests/fixtures/*.txt
!/tests/fixtures/A-*.txt
!/tests/fixtures/B-*.txt

# 项目文档及配套资源随仓库保存，保留文档中的参考备份样本
!/docs/v2/resources/fixtures/*.wwv2
