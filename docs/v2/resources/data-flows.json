[
  {
    "id": "DF-01",
    "title": "小说预览与保存",
    "trigger": "OP-06/09/10",
    "steps": [
      {
        "input": "File首文件",
        "read": "浏览器bytes",
        "transform": "解码UTF8/GBK，按regex切章/10000切块",
        "write": "局部preview.{decode,chapters,regex,bytes}",
        "commit": "仅内存，无DB事务",
        "failure": "错regex/解码显示错误，旧preview保留",
        "consumer": "预览200行与导入守卫"
      },
      {
        "input": "preview有效、用户确认",
        "read": "preview.decode.text与regex",
        "transform": "uuid生成书ID、filename去最后扩展名作为title",
        "write": "T03.{id,title,sourceFileName,createdAt}",
        "commit": "先await设置库单行put",
        "failure": "后续失败没有跨库回滚",
        "consumer": "书架新卡片"
      },
      {
        "input": "ChapterDraft[]",
        "read": "每章index/name/text/order/charCount",
        "transform": "元数据与正文拆表，共享bookId/chapterIndex",
        "write": "T04全记录；T05.{bookId,chapterIndex,text}",
        "commit": "本书两表同事务bulkPut",
        "failure": "事务失败两表不部分写；T03可能已存在",
        "consumer": "窗口、P1、章数"
      },
      {
        "input": "保存章节成功",
        "read": "drafts.length",
        "transform": "构造stage=P1/status=idle/完成失败[]",
        "write": "T12.P1",
        "commit": "独立put，不与建书/章节合为同事务",
        "failure": "这里失败仍可能已有书/章节",
        "consumer": "入库按钮禁用、可阶段处理"
      },
      {
        "input": "仅导入或完整模式",
        "read": "新bookId",
        "transform": "仅导入reset任务；完整模式beginRun后不await runAll",
        "write": "ui.bookId；showImport=false；assetTab人物",
        "commit": "仅内存状态；完整后续另走DF-02",
        "failure": "任务catch写failed日志，书不删除",
        "consumer": "资产工作台"
      }
    ],
    "example": {
      "portable": [
        "P02",
        "P03",
        "P05"
      ],
      "before": {
        "books": [],
        "chapters": []
      },
      "input": {
        "id": "bk_acceptance",
        "title": "测试书",
        "text": "第一章 会面\n甲见乙。"
      },
      "after": {
        "books.count": 1,
        "chapters": [
          {
            "chapterIndex": "1",
            "order": 0,
            "charCount": 11
          }
        ],
        "chapterTexts.0.text": "第一章 会面\n甲见乙。",
        "P1.status": "idle"
      },
      "note": "charCount应取具体字符串UTF16长度；可执行用例直接核正文/章数，完整精确记录由import结果。"
    }
  },
  {
    "id": "DF-02",
    "title": "完整编排与取消恢复",
    "trigger": "OP-10/27/29",
    "steps": [
      {
        "input": "bookId/配置/signal",
        "read": "T04按order、T12各阶段、T16 active",
        "transform": "建100/20窗口、planKey，判断恢复点，ensure会话",
        "write": "T12.P2 running；必要T16建/归档",
        "commit": "分别事务；同JS同书锁包围整个编排",
        "failure": "锁占用拒绝；不删除已有资产",
        "consumer": "窗口调度"
      },
      {
        "input": "当前窗口未完成章",
        "read": "T05.text、T12.P1完成/partial",
        "transform": "世界/叙事独立调用，分配ID；成功部分可用",
        "write": "T06/T07/T08成功数组bulkPut",
        "commit": "三个资产表同事务，随后独立写T12.P1",
        "failure": "失败缺子步骤进入partial；signal取消则不提交在途",
        "consumer": "进度、列表，恢复只补失败"
      },
      {
        "input": "P1本窗处理结束",
        "read": "T06/T07与来源/正文",
        "transform": "DF-05归并；DF-03串联",
        "write": "相应草稿与T13–17；T12.P2完成/失败窗",
        "commit": "各阶段各批提交，非整窗全原子",
        "failure": "degraded/失败窗不推进连续checkpoint，但可处理后窗",
        "consumer": "可继续而不丢先前结果"
      },
      {
        "input": "所有窗口处理后",
        "read": "全书当前草稿",
        "transform": "全局合并与runLink(review=true)",
        "write": "T12.P3；T06–09/T13–17",
        "commit": "本阶段分批保存，最后T12.P3状态",
        "failure": "P1/P2/P3任失败则P3failed；取消不自动入库",
        "consumer": "P3completed仅为当前范围门槛"
      },
      {
        "input": "取消/刷新/继续",
        "read": "T12与T15已有检查点",
        "transform": "abort或重读恢复方案；刷新不后台跑",
        "write": "已提交不撤销；后续T12cancelled/paused显示",
        "commit": "无总回滚；继续才运行",
        "failure": "sleep可延迟取消；旧runtime不代表后台存活",
        "consumer": "CompilePanel、继续按钮"
      }
    ],
    "example": {
      "portable": [
        "P06",
        "P07",
        "P24"
      ],
      "note": "P06明确失败世界/叙事恢复请求次数和前后表；窗口P24明确第100章切块与181原章；完整真实模型全书效果另列验证范围。"
    }
  },
  {
    "id": "DF-03",
    "title": "独立阶段与事件串联提交",
    "trigger": "OP-28与AUTO-12/13",
    "steps": [
      {
        "input": "step/sample",
        "read": "T04、T12.P1",
        "transform": "sample前100原章；非P1只核样本P1全完成",
        "write": "删除T12.P3；p1另删T12.P2",
        "commit": "前置成功后删除旧完成标记",
        "failure": "P1未齐先报错，不擅加P2先后守卫",
        "consumer": "入库放行撤销"
      },
      {
        "input": "P2/P3故事检查",
        "read": "T08当前范围、T09全书、T06/T07、T13–17",
        "transform": "按400节点给ID/摘要，工具按需查询；核Schema/原文/引用",
        "write": "工作内存nodeMap/lineMap，尚不生效",
        "commit": "只有工具submit成功仍不等于DB提交",
        "failure": "失败记录T15 failed/cancelled，保前一批",
        "consumer": "准备提交"
      },
      {
        "input": "有效新节点/操作/记忆",
        "read": "T05引文与当前T08/T09/T13版本/资产signature",
        "transform": "临时ID→正式ID；成员排序；重算chapters/characterIds/eventLineIds；准备指纹",
        "write": "T08/T09/T13/T14/T15及T17 commit，T16末端",
        "commit": "同批多表事务，事务内再核旧读值/版本/会话",
        "failure": "冲突抛错，全批回滚；不能覆盖人工修改",
        "consumer": "列表/图/记忆useLiveQuery"
      },
      {
        "input": "阶段完成",
        "read": "本次失败和旧assets失败",
        "transform": "stage样本模式保存testScope；p3检查所有已提取，不补未提取",
        "write": "T12.P2/P3状态/完成失败；runtime事件",
        "commit": "进度独立事务",
        "failure": "样本通过不表示全书通过；失败不放行",
        "consumer": "测试草稿提示、入库测试草稿"
      }
    ],
    "example": {
      "portable": [
        "P17",
        "P18",
        "P19",
        "P20"
      ],
      "before": {
        "eventLines": [],
        "storyEditorMemory": []
      },
      "input": {
        "event_line_ops": [
          {
            "op": "create",
            "title": "会面线",
            "node_ids": [
              "C1-N001"
            ],
            "cause": "会面",
            "process": "见面",
            "result": "",
            "line_status": "open"
          }
        ],
        "memory_update": {
          "workingSummary": "已核对会面",
          "notes": []
        }
      },
      "after": {
        "line": "L01",
        "nodeIds": [
          "C1-N001"
        ],
        "node.eventLineIds": [
          "L01"
        ],
        "memory.revision": 1,
        "memory.workingSummary": "已核对会面",
        "checkpoint.status": "completed"
      },
      "failureAfter": {
        "lineCount": 0,
        "memoryCount": 0,
        "checkpoint.status": "failed"
      }
    }
  },
  {
    "id": "DF-04",
    "title": "单章试跑不保存资产",
    "trigger": "OP-32/33",
    "steps": [
      {
        "input": "bookId",
        "read": "T04首order章、T05完整正文",
        "transform": "使用P1两次请求同完整章输入",
        "write": "仅局部result，含三类资产与失败",
        "commit": "不调用saveP1Result或putProgress",
        "failure": "请求异常显示error；子步骤失败仍在result",
        "consumer": "左右对照与人工判断"
      },
      {
        "input": "结果显示",
        "read": "sourceText、usages",
        "transform": "sourceText.slice(0,2000)，cost求和，durationMs",
        "write": "局部视图与文案",
        "commit": "无业务保存",
        "failure": "关闭不发abort，结果随卸载丢",
        "consumer": "重跑按钮与费用说明"
      }
    ],
    "example": {
      "input": "任一已导入书首章",
      "after": "T06/T07/T08/T12数量和值均不因试跑而改变",
      "portable": [],
      "verification": "静态路径，UI仅采集弹窗未真实调用模型；无虚构运行通过"
    }
  },
  {
    "id": "DF-05",
    "title": "草稿合并、频次与缓存",
    "trigger": "OP-27/28，ALG-04/05",
    "steps": [
      {
        "input": "当前stage范围",
        "read": "T06/T07选中与sourceChapters；T05全文；T12.P1范围",
        "transform": "人物主名相等/包含、地点仅相等、别名集合>0.9；保最早ID，先本地融合",
        "write": "仅workingCharacters/locations局部",
        "commit": "提交前不替换旧表",
        "failure": "未定义全局安全自动锁",
        "consumer": "AI补充分组/频次"
      },
      {
        "input": "本地组",
        "read": "精简名称别名/identity、description前160",
        "transform": "180条取批/160步；AI只能合本批>=2主名；再融合",
        "write": "局部主名/aliases/sourceChapters/四文本/relations/conflicts",
        "commit": "无单独工具直接写库",
        "failure": "AI失败degraded，保本地底稿",
        "consumer": "主名出场扫描"
      },
      {
        "input": "最终主名",
        "read": "T05处理范围、T06聚合资料",
        "transform": "扫描主名非别名；原章去重/提及次数；分位→roleWeight，manual优先",
        "write": "局部frequency/roleWeight/source",
        "commit": "非单独持久写",
        "failure": "未知/重复主名不重复归属",
        "consumer": "按需人物整编"
      },
      {
        "input": "需整编人物/多描述地点",
        "read": "mergeFacts与缓存、Prompt/schema预算",
        "transform": "短事实ID；固定人物键；覆盖/名称/非空校验；地点描述保底合入",
        "write": "局部四文本/mergeNotes/optimizedFactIds/fingerprint",
        "commit": "AI通过不等于提交；末尾重算主名频次",
        "failure": "超预算/校验错保底，degraded使阶段不通过",
        "consumer": "提交"
      },
      {
        "input": "整轮未取消",
        "read": "原参与快照bulkGet",
        "transform": "JSON比对未变→删除参与旧ID→写保留融合记录",
        "write": "T06/T07参与集合",
        "commit": "两表同事务；范围外不删除",
        "failure": "取消整轮不提交；冲突拒绝覆盖",
        "consumer": "人物/地点列表、入库、记忆依据失效"
      }
    ],
    "example": {
      "portable": [
        "P10",
        "P25",
        "P26"
      ],
      "input": [
        {
          "id": "C1-P001",
          "name": "甲",
          "identity": "书生"
        },
        {
          "id": "C2-P001",
          "name": "甲乙",
          "identity": "来客"
        }
      ],
      "after": {
        "keptId": "C1-P001",
        "aliases": [
          "甲乙"
        ],
        "identity": "书生；来客",
        "sourceChapters": [
          "1",
          "2"
        ]
      },
      "note": "包含聚组无单字守卫是兼容行为；手动指定keepId与自动规则分开。"
    }
  },
  {
    "id": "DF-06",
    "title": "人工编辑与副本/指纹",
    "trigger": "OP-15–20",
    "steps": [
      {
        "input": "表单局部values",
        "read": "UI字段→fromEditable",
        "transform": "CSV中英文逗号分割trim去空；字符串只用trim判空，非空保原文本",
        "write": "patch字段，尚未写库",
        "commit": "无统一必填Schema",
        "failure": "空必填可undefined，不补新校验",
        "consumer": "核心update"
      },
      {
        "input": "人物patch",
        "read": "T06当前行/mergeFacts/cache",
        "transform": "ageText点路径；四文本变则替换该字段事实、移除退休优化ID、清fingerprint",
        "write": "T06 patch/updatedAt；层级另写manual",
        "commit": "人物事务；地点单行更新；Node/Line普通update",
        "failure": "未统一catch UI；无行通常no-op；不撤P3",
        "consumer": "useLiveQuery列表"
      },
      {
        "input": "DB提交",
        "read": "本书查询订阅",
        "transform": "重读新行，不自动setSelected新对象",
        "write": "列表视图；旧详情仍持旧asset",
        "commit": "无新事务",
        "failure": "层级/线状态控件回显旧值BUG-16",
        "consumer": "关闭重开后新详情"
      },
      {
        "input": "后续继续/入库",
        "read": "已变T06–09资料",
        "transform": "记忆读取重算validity；入库才重建实体/人物引用",
        "write": "本次编辑不自动写T10/T11/T08.actorIds/T09.characterIds",
        "commit": "副本非持续同步",
        "failure": "P3completed不自动失效，待处理不归零仍可能入库",
        "consumer": "下轮检查/用户手动发布"
      }
    ],
    "example": {
      "portable": [
        "P08",
        "P09"
      ],
      "input": {
        "id": "C1-P001",
        "patch": {
          "identity": "修改身份",
          "profile.ageText": "约二十岁"
        }
      },
      "after": {
        "characterSnapshots.C1-P001.identity": "修改身份",
        "characterSnapshots.C1-P001.profile.ageText": "约二十岁",
        "characters.count": 0
      },
      "UIVerification": "ui-role-change.txt：列表主要人物，详情仍NPC；关闭重开必须读取已保存值"
    }
  },
  {
    "id": "DF-07",
    "title": "手动并入与快照删除",
    "trigger": "OP-21/23",
    "steps": [
      {
        "input": "keepId+mergeIds",
        "read": "同表目标/其他有效记录",
        "transform": "去掉keepId自身，保指定目标ID；资料/称呼/关系融合",
        "write": "T06或T07目标put、其余delete",
