[
  {
    "object": "编译P1",
    "from": "idle/paused/failed/cancelled",
    "event": "runP1",
    "guard": "存在章节/获得入口锁",
    "write": "T12.running",
    "to": "running",
    "feedback": "进度/日志开始",
    "failure": "加载/读正文异常传播"
  },
  {
    "object": "编译P1",
    "from": "running",
    "event": "章两子步骤全成功",
    "guard": "signal未取消",
    "write": "三资产表保存；completed加入、failed移除、partial删除",
    "to": "running或completed",
    "feedback": "章完成与数量",
    "failure": "资产和进度不是一个事务"
  },
  {
    "object": "编译P1",
    "from": "running",
    "event": "子步骤失败",
    "guard": "有可保存成功部分",
    "write": "保存成功部分；failed加入，partial缺口",
    "to": "failed或paused",
    "feedback": "失败章日志",
    "failure": "继续只补缺口"
  },
  {
    "object": "编译",
    "from": "running",
    "event": "用户取消",
    "guard": "signal检查到",
    "write": "不交当前在途；已有批保留，记录cancelled",
    "to": "cancelled",
    "feedback": "恢复说明",
    "failure": "退避可能延迟"
  },
  {
    "object": "显示进度",
    "from": "DB running/runtime idle",
    "event": "刷新挂载",
    "guard": "旧任务进程已不存在",
    "write": "不写DB",
    "to": "显示paused",
    "feedback": "继续按钮",
    "failure": "须用户继续，不后台续跑"
  },
  {
    "object": "P2窗口",
    "from": "running",
    "event": "一窗归并串联结束",
    "guard": "无degraded/失败",
    "write": "保存窗索引完成；此前无空洞才推进lastWindowIndex",
    "to": "running/阶段完成",
    "feedback": "窗口成功计数",
    "failure": "失败窗保数据不推进checkpoint"
  },
  {
    "object": "P3",
    "from": "running",
    "event": "两项结束",
    "guard": "上下游均无失败",
    "write": "T12.status completed",
    "to": "completed",
    "feedback": "入库UI可用",
    "failure": "任上游失败仍failed"
  },
  {
    "object": "P3样本",
    "from": "running",
    "event": "样本检查完成",
    "guard": "当前已提取范围",
    "write": "T12.completed+testScope",
    "to": "completed（样本）",
    "feedback": "入库测试草稿",
    "failure": "不代表全书完成"
  },
  {
    "object": "人工草稿",
    "from": "任意",
    "event": "普通保存",
    "guard": "行存在，UI仅saving守卫",
    "write": "patch字段，P3不自动删",
    "to": "仍草稿",
    "feedback": "已保存、列表变",
    "failure": "可写空必填；缺少全局兜底"
  },
  {
    "object": "入库实体",
    "from": "空或已有",
    "event": "publishCanon",
    "guard": "UI P3门槛；服务无再核",
    "write": "清表重建实体与引用",
    "to": "当前实体替换",
    "feedback": "数量徽标",
    "failure": "无历史版本/永久稳定ID"
  },
  {
    "object": "笔记",
    "from": "无",
    "event": "新active主题",
    "guard": "有效引用/原文",
    "write": "新增T14，revision>=1",
    "to": "active",
    "feedback": "判断/待复核",
    "failure": "无依据拒绝"
  },
  {
    "object": "笔记",
    "from": "active/resolved",
