    {
      "name": "get_editor_memory",
      "description": "读取当前故事会话的工作记忆；提供 session_id 可回查本书旧会话。历史记录不是本轮已通过的结论。",
      "parameters": {
        "additionalProperties": false,
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string"
          }
        }
      },
      "kind": "read",
      "maxResults": 10,
      "maxBytes": 65536,
      "returns": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "memory",
          "dataChanged",
          "pendingCount",
          "staleCount",
          "notes",
          "recentCheckpoints"
        ],
        "properties": {
          "memory": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "id",
              "bookId",
              "revision",
              "workingSummary",
              "dataFingerprint",
              "updatedAt"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "bookId": {
                "type": "string"
              },
              "sessionId": {
                "type": "string"
              },
              "revision": {
                "minimum": 0,
                "type": "integer"
              },
              "workingSummary": {
                "maxLength": 2000,
                "type": "string"
              },
              "dataFingerprint": {
                "type": "string"
              },
              "updatedAt": {
                "type": "string"
              }
            }
          },
          "dataChanged": {
            "type": "boolean"
          },
          "pendingCount": {
            "type": "integer"
          },
          "staleCount": {
            "type": "integer"
          },
          "notes": {
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "key",
                "kind",
                "status",
                "statement",
                "nodeIds",
                "lineIds",
                "validity",
                "truncated"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "key": {
                  "minLength": 1,
                  "maxLength": 120,
                  "description": "稳定的工作主题键；更新或解决同一事项时复用该键。",
                  "type": "string"
                },
                "kind": {
                  "anyOf": [
                    {
                      "const": "decision",
                      "type": "string"
                    },
                    {
                      "const": "review",
                      "type": "string"
                    }
                  ]
                },
                "status": {
                  "anyOf": [
                    {
                      "const": "active",
                      "type": "string"
                    },
                    {
                      "const": "resolved",
                      "type": "string"
                    }
                  ]
                },
                "statement": {
                  "minLength": 1,
                  "maxLength": 1000,
                  "description": "简短结论、待核事项或解决说明，不保存长篇推理。",
                  "type": "string"
                },
                "nodeIds": {
                  "maxItems": 20,
                  "type": "array",
                  "items": {
                    "maxLength": 128,
                    "type": "string"
                  }
                },
                "lineIds": {
                  "maxItems": 20,
                  "type": "array",
                  "items": {
                    "maxLength": 128,
                    "type": "string"
                  }
                },
                "validity": {
                  "anyOf": [
                    {
                      "const": "current",
                      "type": "string"
                    },
                    {
                      "const": "stale",
                      "type": "string"
                    }
                  ]
                },
                "truncated": {
                  "type": "boolean"
                }
              }
            }
          },
          "recentCheckpoints": {
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "stage",
                "phase",
                "status",
                "scopeCount",
                "updatedAt"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "stage": {
                  "type": "string"
                },
                "phase": {
                  "type": "string"
                },
                "status": {
                  "type": "string"
                },
                "scopeCount": {
                  "type": "integer"
                },
                "updatedAt": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "query_editor_notes",
      "description": "查询已确认判断、待复核或已解决事项，按节点/事件线定位。过期结论不得直接沿用，核实后通过提交结果更新。",
