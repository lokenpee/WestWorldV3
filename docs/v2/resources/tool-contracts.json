          },
          "key": {
            "maxLength": 120,
            "type": "string"
          },
          "status": {
            "anyOf": [
              {
                "const": "active",
                "type": "string"
              },
              {
                "const": "resolved",
                "type": "string"
              },
              {
                "const": "stale",
                "type": "string"
              }
            ]
          },
          "node_id": {
            "type": "string"
          },
          "line_id": {
            "type": "string"
          },
          "offset": {
            "minimum": 0,
            "type": "integer"
          },
          "limit": {
            "minimum": 1,
            "maximum": 200,
            "type": "integer"
          }
        }
      },
      "kind": "read",
      "maxResults": 50,
      "maxBytes": 65536,
      "returns": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "data",
          "totalCount",
          "truncated",
          "nextOffset"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "key",
                "kind",
                "status",
                "statement",
                "nodeIds",
                "lineIds",
                "evidence",
                "id",
                "bookId",
                "revision",
                "stage",
                "basisFingerprint",
                "createdAt",
                "updatedAt",
                "validity"
              ],
              "properties": {
                "key": {
                  "minLength": 1,
                  "maxLength": 120,
                  "description": "稳定的工作主题键；更新或解决同一事项时复用该键。",
                  "type": "string"
                },
                "kind": {
                  "anyOf": [
                    {
                      "const": "decision",
                      "type": "string"
                    },
                    {
                      "const": "review",
                      "type": "string"
                    }
                  ]
                },
                "status": {
                  "anyOf": [
                    {
                      "const": "active",
                      "type": "string"
                    },
                    {
                      "const": "resolved",
                      "type": "string"
                    }
                  ]
                },
                "statement": {
                  "minLength": 1,
                  "maxLength": 1000,
                  "description": "简短结论、待核事项或解决说明，不保存长篇推理。",
                  "type": "string"
                },
                "nodeIds": {
                  "maxItems": 20,
                  "type": "array",
                  "items": {
                    "maxLength": 128,
                    "type": "string"
                  }
                },
                "lineIds": {
                  "maxItems": 20,
                  "type": "array",
                  "items": {
                    "maxLength": 128,
                    "type": "string"
                  }
                },
                "evidence": {
                  "maxItems": 5,
                  "description": "逐字原文证据。已有有效 nodeIds/lineIds 时可用空数组；不要为每条判断重复抄原文或猜章节号。",
                  "type": "array",
                  "items": {
                    "additionalProperties": false,
                    "type": "object",
                    "required": [
                      "chapterIndex",
                      "quote"
                    ],
                    "properties": {
                      "chapterIndex": {
                        "description": "工具返回的原文章节标识，必须与逐字引文所在章节对应，不能猜章节编号。",
                        "type": "string"
                      },
                      "quote": {
                        "minLength": 1,
                        "maxLength": 1000,
                        "description": "该章节中连续存在的逐字原句，不要改写、拼接或增加标点。",
                        "type": "string"
                      }
                    }
                  }
                },
                "id": {
                  "type": "string"
                },
                "bookId": {
                  "type": "string"
                },
                "revision": {
                  "minimum": 1,
                  "type": "integer"
                },
                "sessionId": {
                  "type": "string"
                },
                "stage": {
                  "anyOf": [
                    {
                      "const": "P2",
                      "type": "string"
                    },
                    {
                      "const": "P3",
                      "type": "string"
                    }
                  ]
                },
                "basisFingerprint": {
                  "type": "string"
                },
                "createdAt": {
                  "type": "string"
                },
                "updatedAt": {
                  "type": "string"
                },
                "validity": {
                  "anyOf": [
                    {
                      "const": "current",
                      "type": "string"
                    },
                    {
                      "const": "stale",
                      "type": "string"
                    }
                  ]
                }
              }
            }
          },
          "totalCount": {
            "type": "integer"
          },
          "truncated": {
            "type": "boolean"
          },
          "nextOffset": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
