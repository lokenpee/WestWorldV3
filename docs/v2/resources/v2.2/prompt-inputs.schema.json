{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "WorkRef": {
      "type": "object",
      "properties": {
        "workItemId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "character",
            "location",
            "node",
            "eventLine",
            "note",
            "chapter"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "description": "章节无revision时固定0"
        },
        "factFingerprint": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "workItemId",
        "kind",
        "id",
        "revision",
        "factFingerprint"
      ],
      "additionalProperties": false
    },
    "ResumeInfo": {
      "type": "object",
      "properties": {
        "reason": {
          "enum": [
            "initial",
            "continuation",
            "interrupted",
            "conflict"
          ]
        },
        "appliedCommitIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "nextOperationKey": {
          "type": "string",
          "description": "应用建议的下一命令键；模型可用其他未使用非空键，但不能换旧键的payload",
          "minLength": 1
        },
        "remainingWorkIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "reason",
        "appliedCommitIds",
        "nextOperationKey",
        "remainingWorkIds"
      ],
      "additionalProperties": false
    },
    "TaskIdentity": {
      "type": "object",
      "properties": {
        "bookId": {
          "type": "string",
          "minLength": 1
        },
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "taskId": {
          "type": "string",
          "minLength": 1
        },
        "planVersion": {
          "const": "2.2"
        },
        "remainingCount": {
          "type": "integer",
          "minimum": 0
        },
        "resume": {
          "$ref": "#/$defs/ResumeInfo"
        }
      },
      "required": [
        "bookId",
        "runId",
        "taskId",
        "planVersion",
        "remainingCount",
        "resume"
      ],
      "additionalProperties": false
    },
    "ChapterTask": {
      "type": "object",
      "properties": {
        "chapterIndex": {
          "type": "string",
          "minLength": 1
        },
        "chapterName": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "chapterIndex",
        "chapterName",
        "text"
      ],
      "additionalProperties": false
    },
    "IdentityTask": {
      "type": "object",
      "properties": {
        "bookId": {
          "type": "string",
          "minLength": 1
        },
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "taskId": {
          "type": "string",
          "minLength": 1
        },
        "planVersion": {
          "const": "2.2"
        },
        "remainingCount": {
          "type": "integer",
          "minimum": 0
        },
        "resume": {
          "$ref": "#/$defs/ResumeInfo"
        },
        "stage": {
          "const": "P2"
        },
        "phase": {
          "const": "ai_identity"
        },
        "kind": {
          "enum": [
            "character",
            "location"
          ]
        },
        "scope": {
          "const": "fullBook"
        },
        "workItems": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WorkRef"
          },
          "minItems": 1,
          "maxItems": 180
        },
        "afterId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "pageLimit": {
          "const": 100
        }
      },
      "required": [
        "bookId",
        "runId",
        "taskId",
        "planVersion",
        "remainingCount",
        "resume",
        "stage",
        "phase",
        "kind",
        "scope",
        "workItems",
        "afterId",
        "pageLimit"
      ],
      "additionalProperties": false
    },
    "LineDigest": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "nodeIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "chapters": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lineStatus": {
          "enum": [
            "open",
            "closed"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "nodeIds",
        "chapters",
        "lineStatus",
        "revision"
      ],
      "additionalProperties": false
    },
    "Window": {
      "type": "object",
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        },
        "chapterIndices": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "start",
        "end",
        "chapterIndices"
      ],
      "additionalProperties": false
    },
    "StoryTask": {
      "type": "object",
      "properties": {
        "bookId": {
          "type": "string",
          "minLength": 1
        },
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "taskId": {
          "type": "string",
          "minLength": 1
        },
        "planVersion": {
          "const": "2.2"
        },
        "remainingCount": {
          "type": "integer",
          "minimum": 0
        },
        "resume": {
          "$ref": "#/$defs/ResumeInfo"
        },
        "stage": {
          "const": "P3"
        },
        "phase": {
          "enum": [
            "window_link",
            "global_review"
          ]
        },
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "queue": {
          "enum": [
            "window_nodes",
            "orphans",
            "event_lines",
            "review_notes"
          ]
        },
        "window": {
          "anyOf": [
            {
              "$ref": "#/$defs/Window"
            },
            {
              "type": "null"
            }
          ]
        },
        "workItems": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WorkRef"
          },
          "minItems": 1,
          "maxItems": 100
        },
        "existingLines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LineDigest"
          },
          "maxItems": 50
        },
        "memory": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "id",
            "bookId",
            "revision",
            "workingSummary",
            "dataFingerprint",
            "updatedAt"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "bookId": {
              "type": "string"
            },
            "sessionId": {
              "type": "string"
            },
            "revision": {
              "minimum": 0,
              "type": "integer"
            },
            "workingSummary": {
              "type": "string"
            },
            "dataFingerprint": {
              "type": "string"
            },
            "updatedAt": {
              "type": "string"
            }
          }
        },
        "afterWorkItemId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "bookId",
        "runId",
        "taskId",
        "planVersion",
        "remainingCount",
        "resume",
        "stage",
        "phase",
        "sessionId",
        "queue",
        "window",
        "workItems",
        "existingLines",
        "memory",
        "afterWorkItemId"
      ],
      "additionalProperties": false
    },
    "Fact": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "field": {
          "enum": [
            "identity",
            "appearance",
            "personality",
            "background",
            "description"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "field",
        "text"
      ],
      "additionalProperties": false
    },
    "CharacterOptimizationItem": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "previous": {
          "type": "object",
          "properties": {
            "identity": {
              "type": "string"
            },
            "appearance": {
              "type": "string"
            },
            "personality": {
              "type": "string"
            },
            "background": {
              "type": "string"
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Fact"
          },
          "minItems": 1
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "name",
        "aliases",
        "revision",
        "reason",
        "previous",
        "facts",
        "conflicts"
      ],
      "additionalProperties": false
    },
    "CharacterOptimizationTask": {
      "type": "object",
      "properties": {
        "stage": {
          "const": "P2"
        },
        "entities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CharacterOptimizationItem"
          },
          "minItems": 1,
          "maxItems": 3
        }
      },
      "required": [
        "stage",
        "entities"
      ],
      "additionalProperties": false
    },
    "LocationOptimizationTask": {
      "type": "object",
      "properties": {
        "stage": {
          "const": "P2"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "description": {
          "type": "string"
        },
        "facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Fact"
          },
          "minItems": 1
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "stage",
        "id",
        "name",
        "revision",
        "description",
        "facts",
        "conflicts"
      ],
      "additionalProperties": false
    },
    "CompactionTask": {
      "type": "object",
      "properties": {
        "previousSummary": {
          "type": "string"
        },
        "transcript": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "previousSummary",
        "transcript"
      ],
      "additionalProperties": false
    },
    "DirectProbeTask": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "AgentProbeTask": {
      "type": "object",
      "properties": {
        "suite": {
          "enum": [
            "asset",
            "story"
          ]
        },
        "taskId": {
          "type": "string",
          "minLength": 1
        },
        "operationKey": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "suite",
        "taskId",
        "operationKey"
      ],
      "additionalProperties": false
    },
    "StoryReadingBrief": {
      "type": "object",
      "description": "P3模型收到的业务资料；页面及进度由程序提供，不包含内部运行凭据。",
      "properties": {
        "phase": {
          "enum": [
            "window_link",
            "global_review"
          ]
        },
        "queue": {
          "type": "string"
        },
        "page": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "pageNumber": {
              "type": "integer"
            },
            "totalPages": {
              "type": "integer"
            },
            "type": {
              "enum": [
                "node_page",
                "directory_open",
                "member_batch",
                "directory_final",
                "line_segment",
                "line_structure",
                "event_summary",
                "line_summary",
                "note_page"
              ]
            },
            "ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "lineId": {
              "type": "string"
            },
            "eventId": {
              "type": "string"
            },
            "segment": {
              "type": "integer"
            },
            "totalSegments": {
              "type": "integer"
            }
          },
          "required": [
            "id",
            "pageNumber",
            "totalPages",
            "type",
            "ids"
          ],
          "additionalProperties": true
        },
        "remainingCount": {
          "type": "integer"
        },
        "workItems": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "related": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "moreRelated": {
          "type": "boolean"
        },
        "workingSummary": {
          "type": "string"
        }
      },
      "required": [
        "phase",
        "queue",
        "page",
        "workItems"
      ],
      "additionalProperties": true
    },
    "NarrativeBrief": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "event_group",
                "line_cycle",
                "line_review"
              ]
            },
            "part": {
              "enum": [
                "batch",
                "structure",
                "doubts",
                "unassigned",
                "descriptions"
              ]
            },
            "targets": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  }
                },
                "required": [
                  "id"
                ]
              }
            },
            "periodIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "outline": {
              "type": "object",
              "properties": {
                "events": {
                  "type": "array"
                },
                "lines": {
                  "type": "array"
                },
                "nodes": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "name"
                    ],
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      }
                    }
                  }
                },
                "unassignedNodeIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "unassignedEventIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "events"
              ]
            },
            "openDoubts": {
              "type": "array"
            },
            "config": {
              "$ref": "#/$defs/NarrativeConfig"
            },
            "evidence": {
              "type": "object",
              "properties": {
                "nodes": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "events": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              },
              "additionalProperties": false
            },
            "reviewProgress": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "环节",
                  "已核",
                  "待核"
                ],
                "properties": {
                  "环节": {
                    "type": "string"
                  },
                  "已核": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "待核": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "required": [
            "mode",
            "part",
            "targets"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "part",
            "material"
          ],
          "properties": {
            "mode": {
              "const": "link_node"
            },
            "part": {
              "const": "batch"
            },
            "material": {
              "type": "object",
              "required": [
                "当前节点"
              ],
              "properties": {
                "当前节点": {
                  "type": "object"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "part",
            "material"
          ],
          "properties": {
            "mode": {
              "const": "review_event"
            },
            "part": {
              "const": "structure"
            },
            "material": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "全书事件目录",
                "本轮重点事件及直接关联事件",
                "本组成员时间表",
                "本轮任务"
              ],
              "properties": {
                "全书事件目录": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "event_id",
                      "name",
                      "overview"
                    ],
                    "properties": {
                      "event_id": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "overview": {
                        "type": "string"
                      }
                    }
                  }
                },
                "本轮重点事件及直接关联事件": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "重点事件ID",
                    "事件"
                  ],
                  "properties": {
                    "重点事件ID": {
                      "type": "string"
                    },
                    "事件": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "event_id",
                          "latest_progress",
                          "unresolved",
                          "status",
                          "clues"
                        ],
                        "properties": {
                          "event_id": {
                            "type": "string"
                          },
                          "latest_progress": {
                            "type": "string"
                          },
                          "unresolved": {
                            "type": "string"
                          },
                          "status": {
                            "type": "string"
                          },
                          "clues": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "本组成员时间表": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "node_id",
                      "name",
                      "summary",
                      "event_ids"
                    ],
                    "properties": {
                      "node_id": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "summary": {
                        "type": "string"
                      },
                      "event_ids": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                },
                "上次待核实事项": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "issue",
                      "checked_scope",
                      "reason"
                    ],
                    "properties": {
                      "issue": {
                        "type": "string"
                      },
                      "checked_scope": {
                        "type": "string"
                      },
                      "reason": {
                        "type": "string"
                      }
                    }
                  }
                },
                "本轮任务": {
                  "type": "string"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "review_boundaries"
            },
            "part": {
              "const": "structure"
            },
            "material": {
              "type": "object",
              "properties": {
                "资料说明": { "type": "string" },
                "本组事件": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "event_id": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "overview": {
                        "type": "string"
                      },
                      "latest_progress": {
                        "type": "string"
                      },
                      "unresolved": {
                        "type": "string"
                      },
                      "clues": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "status": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "event_id",
                      "name",
                      "overview",
                      "latest_progress",
                      "unresolved",
                      "clues",
                      "status"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1
                },
                "节点时间表": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "node_id": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "summary": {
                        "type": "string"
                      },
                      "event_ids": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "event_id": {
                              "type": "string"
                            },
                            "name": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "event_id",
                            "name"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "node_id",
                      "name",
                      "summary",
                      "event_ids"
                    ],
                    "additionalProperties": false
                  }
                },
                "本轮任务": {
                  "type": "string"
                },
                "转回依据": {
