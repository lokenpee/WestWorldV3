{
  "id": "PROMPT-P2-LOCATION",
  "kind": "synthetic-target-request-not-a-recording",
  "inputSchema": "prompt-inputs.schema.json#/$defs/LocationOptimizationTask",
  "input": {
    "stage": "P2",
    "id": "C1-L001",
    "name": "码头",
    "revision": 1,
    "description": "河边的码头",
    "facts": [
      {
        "id": "F1",
        "field": "description",
        "text": "河边的码头"
      }
    ],
    "conflicts": []
  },
  "mode": "direct",
  "modelSnapshot": {
    "providerId": "deepseek",
    "api": "openai-completions",
    "baseUrl": "https://api.deepseek.com",
    "modelId": "deepseek-v4-pro",
    "modelRole": "aggregation",
    "contextWindow": 128000,
    "capabilities": {
      "tools": true,
      "structuredOutput": true
    },
    "credentialRef": "deepseek"
  },
  "options": {
    "temperature": 0,
    "maxTokens": 8192,
    "timeoutMs": 180000
  },
  "context": {
    "systemPrompt": "# P2 按需整编地点展示描述\n\n输入为已确认同一地点的当前description、固定事实ID列表、来源和冲突；仅在过长、高重复或冲突触发时读取。合并判同已结束，你不再决定哪些地点是同一个。\n\n通过submit_result返回description和coveredFactIds（完整、不重复覆盖输入事实ID），可返回conflicts。合并同义表达、去重复，保留不同时间状态与原文分歧，不编造、不丢独立事实；不能把府邸和内部院落的资料当同一对象融合。代码保留mergeFacts底稿，核完整覆盖和revision后替换展示描述，失败保留机械结果并报告降级。\n\n输入固定为{stage,id,name,revision,description,facts,conflicts}。facts.id是本次F1/F2短号，field固定description；所有事实都须覆盖。description是当前展示稿；它与事实冲突时保留事实及分歧，不从旧展示稿补造新事实。只返回description、coveredFactIds、可选conflicts，不返回id/revision。\n",
    "messages": [
      {
        "role": "user",
        "content": "{\"conflicts\":[],\"description\":\"河边的码头\",\"facts\":[{\"field\":\"description\",\"id\":\"F1\",\"text\":\"河边的码头\"}],\"id\":\"C1-L001\",\"name\":\"码头\",\"revision\":1,\"stage\":\"P2\"}",
        "timestamp": 1792800000000
      }
    ],
    "tools": [
      {
        "name": "submit_result",
        "description": "提交符合本次Schema的结构化结果；由调用方校验并应用。",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "description",
            "coveredFactIds"
          ],
          "properties": {
            "description": {
              "type": "string",
              "minLength": 1
            },
            "coveredFactIds": {
              "type": "array",
              "items": {
                "enum": [
                  "F1"
                ]
              },
              "minItems": 1,
              "maxItems": 1,
              "uniqueItems": true
            },
            "conflicts": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "constrainedSampling": {
          "type": "json_schema",
          "strict": "prefer"
        }
      }
    ]
  }
}
