                  "latest_progress",
                  "unresolved"
                ]
              }
            }
          },
          "required": [
            "groups"
          ]
        }
      },
      {
        "name": "search_nodes",
        "description": "按详细经过字面匹配，组内全部满足、组间任一满足。区间不含端点。可搜全书。默认返回 node_id、name、summary，可用 return_fields 选择字段。最多 100 项；truncated 为 true 时缩小条件。",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "groups": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "after_node_id": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "before_node_id": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "exclude_event_id": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "return_fields": {
              "type": "array",
              "minItems": 0,
              "items": {
                "type": "string",
                "enum": [
                  "name",
                  "summary",
                  "detail",
                  "event_ids",
                  "source_position"
                ]
              }
            }
          },
          "required": [
            "groups"
          ]
        }
      },
      {
        "name": "edit_events",
        "description": "只允许 update 当前主审事件。nodeIds 是修改后的完整成员列表。拆并或新建请转回宏观。",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "changes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "op": {
                        "const": "update"
                      },
                      "event_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "fields": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "name": {
                            "type": "string",
                            "minLength": 1
                          },
                          "overview": {
                            "type": "string",
                            "minLength": 1
                          },
                          "latest_progress": {
                            "type": "string",
                            "minLength": 1
                          },
                          "unresolved": {
                            "type": "string"
                          },
                          "clues": {
                            "type": "array",
                            "minItems": 0,
                            "items": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "status": {
                            "type": "string",
                            "enum": [
                              "进行中",
                              "暂时搁置",
                              "已闭环"
                            ]
                          },
                          "nodeIds": {
                            "type": "array",
                            "minItems": 1,
                            "items": {
                              "type": "string",
                              "minLength": 1
                            },
                            "uniqueItems": true
                          }
                        },
                        "required": [],
                        "minProperties": 1
                      },
                      "reason": {
                        "type": "string",
                        "minLength": 1
                      },
                      "evidence_node_ids": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "string",
                          "minLength": 1
                        },
                        "uniqueItems": true
                      }
                    },
                    "required": [
                      "op",
                      "event_id",
                      "fields",
                      "reason"
                    ]
                  }
                ]
              }
            }
          },
          "required": [
            "changes"
          ]
        }
      },
      {
        "name": "confirm",
        "description": "只确认当前事件。completed 表示经过已核实；pending_review 填 pending_issues；return_to_macro 填 event_ids（含当前事件）、evidence_node_ids 和 reason。",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "result": {
              "type": "string",
              "enum": [
                "completed",
                "pending_review",
                "return_to_macro"
              ]
            },
            "pending_issues": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "issue": {
                    "type": "string",
                    "minLength": 1
                  },
                  "checked_scope": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "issue",
                  "checked_scope",
                  "reason"
                ]
              }
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "event_ids": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "evidence_node_ids": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "required": [
            "result"
          ],
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "result": {
                  "const": "completed"
                }
              },
              "required": [
                "result"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "result": {
                  "const": "pending_review"
                },
                "pending_issues": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "issue": {
                        "type": "string",
                        "minLength": 1
                      },
                      "checked_scope": {
                        "type": "string",
                        "minLength": 1
                      },
                      "reason": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "issue",
                      "checked_scope",
                      "reason"
                    ]
                  }
                }
              },
              "required": [
                "result",
                "pending_issues"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "result": {
                  "const": "return_to_macro"
                },
                "event_ids": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                },
                "evidence_node_ids": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "result",
                "event_ids",
                "evidence_node_ids",
                "reason"
              ]
            }
          ]
        }
      }
    ]
  }
}
