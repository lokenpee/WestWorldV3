{
  "name": "westworldv3",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test && playwright test --config playwright.workspace.config.ts",
    "test:workspace": "playwright test --config playwright.workspace.config.ts",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json",
    "build:probe": "vite build --config tests/browser/vite.config.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.0.2",
    "@earendil-works/pi-ai": "1.0.2",
    "dexie": "4.4.6",
    "fflate": "0.8.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "6.2.6",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "5.0.5"
  }
}
